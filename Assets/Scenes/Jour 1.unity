  m_Script: {fileID: 11500000, guid: de6b3cbb30b8bc144bf44d46d89b4a5b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueContainer: {fileID: 1908598171}
  Task: {fileID: 565975118}
  textComponent: {fileID: 1875141860}
  nameComponent: {fileID: 1897674284}
  textSpeed: 0.02
  continueIcon: {fileID: 1946492751}
  vitaSound: {fileID: 8300000, guid: 6cb74dc6ca1198a4481b995b98a67fe0, type: 3}
  joueurSound: {fileID: 8300000, guid: 969be66f623e520469887fcec7f38c58, type: 3}
  typeSoundVolume: 0.5
  namedDialogues:
  - name: Reveil
    dialogues:
    - character: 0
      line: "Votre nourriture est arriv\xE9e"
      lineEvent:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 565975118}
            m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
            m_MethodName: SetActive
            m_Mode: 6
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
    - character: 1
      line: "D\xE9j\xE0 ? Je n'ai m\xEAme pas vu le temps passer."
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
    - character: 0
      line: Elle vous attend dans le monte-charge.
      lineEvent:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 565975118}
            m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
            m_MethodName: SetActive
            m_Mode: 6
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 1
            m_CallState: 2
          - m_Target: {fileID: 565975117}
            m_TargetAssemblyTypeName: TaskManager, Assembly-CSharp
            m_MethodName: setTaskText
            m_Mode: 5
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: "R\xE9cup\xE9rer la commande de nourriture"
              m_BoolArgument: 0
            m_CallState: 2
          - m_Target: {fileID: 565975117}
            m_TargetAssemblyTypeName: TaskManager, Assembly-CSharp
            m_MethodName: CreateTask
            m_Mode: 3
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 1
              m_FloatArgument: 0
              m_StringArgument: "R\xE9cup\xE9rer la commande de nourriture"
              m_BoolArgument: 0
            m_CallState: 2
  - name: Nourriture
    dialogues:
    - character: 0
      line: "Installez-vous tranquillement \xE0 table pour manger."
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
  - name: Manger
    dialogues:
    - character: 1
      line: "VITA, qu'est-ce qu'il me reste \xE0 faire ?"
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
    - character: 0
      line: "Votre productivit\xE9 a \xE9t\xE9 assez bonne pour aujourd'hui. Vous
        pouvez choisir entre aller dormir tout de suite ou vous d\xE9tendre devant
        un film."
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
    - character: 1
      line: J'en ai assez pour aujourd'hui, je vais aller me coucher.
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
    - character: 0
      line: "Tr\xE8s bien, pensez \xE0 vous brosser les dents."
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
  - name: Brossage
    dialogues:
    - character: 0
      line: "Et n'oubliez pas vos m\xE9dicaments."
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
  - name: PriseMedoc
    dialogues:
    - character: 0
      line: Parfait, maintenant vous pouvez aller vous coucher. Bonne nuit !
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
    - character: 1
      line: Bonne nuit...
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
  playerMove: {fileID: 1794285570}
  cameraController: {fileID: 1794285569}
