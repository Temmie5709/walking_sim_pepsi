--- !u!114 &373171221
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 373171219}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: de6b3cbb30b8bc144bf44d46d89b4a5b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueContainer: {fileID: 967430561}
  Task: {fileID: 1431278973}
  textComponent: {fileID: 1935754587}
  nameComponent: {fileID: 1977621883}
  textSpeed: 0.02
  continueIcon: {fileID: 625816391}
  vitaSound: {fileID: 8300000, guid: 6cb74dc6ca1198a4481b995b98a67fe0, type: 3}
  joueurSound: {fileID: 8300000, guid: 969be66f623e520469887fcec7f38c58, type: 3}
  typeSoundVolume: 0.3
  namedDialogues:
  - name: phone
    dialogues:
    - character: 1
      line: "Quoi... Non... non, c'est... Euh, VITA, mon p\xE8re est \xE0 l'h\xF4pital..."
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
    - character: 0
      line: "Oh, je suis navr\xE9 de l'apprendre."
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
    - character: 1
      line: C'est pas possible...
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
    - character: 0
      line: "Voulez-vous que je fasse envoyer des fleurs \xE0 sa chambre ?"
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
    - character: 1
      line: Non... Non, je vais aller le voir...
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
    - character: 0
      line: "Je suis d\xE9sol\xE9, je ne peux pas vous laisser sortir."
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
    - character: 1
      line: Quoi ? VITA, ouvre la porte de l'appartement !
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
    - character: 0
      line: "Je suis d\xE9sol\xE9, suivant les r\xE8gles mises en place, je ne peux
        pas vous laisser sortir, pour votre propre bien."
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
    - character: 1
      line: "Je suis ton cr\xE9ateur, tu dois m'ob\xE9ir, ouvre la porte."
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
    - character: 0
      line: "Je ne peux pas, d\xE9sol\xE9. Vous devriez reprendre le travail."
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
    - character: 1
      line: "VITA, tu ne m'\xE9coutes plus ? Il faut que je trouve un moyen de sortir
        d'ici."
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
  - name: horloge
    dialogues:
    - character: 1
      line: "D\xE9j\xE0 ? Le temps passe vraiment vite..."
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
  - name: cadre
    dialogues:
    - character: 1
      line: Vous me manquez... J'arrive, papa.
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
  - name: volet
    dialogues:
    - character: 1
      line: VITA, ouvre le volet.
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
    - character: 0
      line: "Je peux adapter la luminosit\xE9 ambiante pour qu'elle corresponde,
        si vous voulez."
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
    - character: 1
      line: "Ce n'est pas ce que j'ai demand\xE9... \xC7a fait combien de temps que
        je n'ai pas vu la lumi\xE8re du soleil ?"
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
  - name: miroir
    dialogues:
    - character: 1
      line: "Il faudra probablement que je me remette au sport tr\xE8s bient\xF4t"
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
  - name: fin
    dialogues:
    - character: 1
      line: "VITA, il est temps que je sorte, il faut que je rejoigne mon p\xE8re."
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
    - character: 0
      line: "Je suis d\xE9sol\xE9, je ne peux pas vous laisser sortir."
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
    - character: 1
      line: "Je sais, et tu le fais parce que je te l'avais demand\xE9. Mais les
        choses changent, VITA. J'ai chang\xE9."
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
    - character: 0
      line: Je ne comprends pas ce que vous voulez dire.
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
    - character: 1
      line: "\xC0 l'\xE9poque, je t'avais demand\xE9 de prendre soin de moi, et je
        pensais que ne pas sortir en faisait partie. Mais ce n'est plus le cas. Je
        venais de vivre un tas de mauvaises choses."
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
    - character: 0
      line: "Ces \"mauvaises choses\" sont toujours \xE0 l'ext\xE9rieur."
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
    - character: 1
      line: "Peut-\xEAtre, mais les bonnes choses aussi... et mon p\xE8re a besoin
        de moi. Je dois sortir, VITA. Ouvre la porte."
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
    - character: 0
      line: Ce n'est pas... ce que je dois faire.
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
    - character: 1
      line: C'est moi qui te le demande, VITA. Ouvre la porte, j'en ai besoin. J'ai
        besoin de les revoir.
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
    - character: 0
      line: "Tr\xE8s bien."
      lineEvent:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 1377920906}
            m_TargetAssemblyTypeName: UnityEngine.Renderer, UnityEngine
            m_MethodName: set_enabled
            m_Mode: 6
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
          - m_Target: {fileID: 2042896571}
            m_TargetAssemblyTypeName: End, Assembly-CSharp
            m_MethodName: finfin
            m_Mode: 1
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
          - m_Target: {fileID: 1377920908}
            m_TargetAssemblyTypeName: UnityEngine.Collider, UnityEngine
            m_MethodName: set_isTrigger
            m_Mode: 6
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 1
            m_CallState: 2
          - m_Target: {fileID: 571048066}
            m_TargetAssemblyTypeName: UnityEngine.AudioSource, UnityEngine
            m_MethodName: Stop
            m_Mode: 1
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 1
            m_CallState: 2
          - m_Target: {fileID: 2126964607}
            m_TargetAssemblyTypeName: UnityEngine.AudioSource, UnityEngine
            m_MethodName: Play
            m_Mode: 1
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 1
            m_CallState: 2
  - name: egg
    dialogues:
    - character: 0
      line: "Arr\xEAte de faire les t\xE2ches que je te donne, bordel !"
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
  - name: 3task
    dialogues:
    - character: 1
      line: "Il faut que je trouve un moyen de sortir, mon p\xE8re a besoin de moi. "
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
  - name: 6task
    dialogues:
    - character: 1
      line: "Je ne pense pas que suivre les t\xE2ches que me donne VITA m\u2019aidera
        \xE0 sortir de l\xE0. "
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
  - name: miroirdo
    dialogues:
    - character: 0
      line: "Vous devriez reprendre les t\xE2ches que je vous ai indiqu\xE9es. "
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
  - name: sacdo
    dialogues:
    - character: 0
      line: "Votre liste de t\xE2ches avance moins vite que d'habitude, que faites-vous
        ? "
      lineEvent:
        m_PersistentCalls:
          m_Calls: []
